FROM rust:1.97.0-bookworm AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --locked --release --bin backend-fixture

FROM debian:bookworm-slim

COPY --from=builder /build/target/release/backend-fixture /usr/local/bin/backend-fixture

USER 65534:65534
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=2s --retries=3 \
    CMD ["/usr/local/bin/backend-fixture", "--healthcheck", "127.0.0.1:8080"]

ENTRYPOINT ["/usr/local/bin/backend-fixture"]
